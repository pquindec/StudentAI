{
  "name": "ai-study-assistant",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "gen:api": "cd ../backend && .venv/bin/python -m app.export_openapi ../app/src/lib/api/openapi.json && cd ../app && npx -y -p typescript@5.9.3 -p openapi-typescript@7.13.0 openapi-typescript src/lib/api/openapi.json -o src/lib/api/schema.d.ts",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.4",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
